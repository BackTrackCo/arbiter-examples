X402R_CHAIN=base-sepolia
X402R_RPC_URL=https://base-sepolia-rpc.publicnode.com
# Obtain the arbiter ADDRESS and operator registration from People's Court.
# The developer never needs the arbiter private key.
X402R_ARBITER_ADDRESS=
X402R_OPERATOR_TERMS_HASH=518669710687625d2c6260229475a23eef322879c607a0bd73fb588cbf113f1a
# Leave operator unset to deploy the deterministic 31-day preset.
# If supplied, setup verifies it matches that preset before reuse.
X402R_OPERATOR_ADDRESS=
MERCHANT_PRIVATE_KEY=
PAYER_PRIVATE_KEY=
ARBITRATOR_API_URL=http://localhost:3418
MERCHANT_URL=http://localhost:4021
MERCHANT_PORT=4021
# Optional public HTTPS URL forwarding to the merchant's POST /notice.
# Needed to receive the exact consent message on the fee-gated hosted path.
ARBITRATION_NOTICE_ENDPOINT=
# An operator integration credential provisioned by People's Court.
X402R_WEBHOOK_SECRET=
