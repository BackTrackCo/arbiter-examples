# Arbiter — judges response bodies against spec.json, releases escrowed funds on PASS
# Also used by `pnpm run setup` to deploy operator contracts

# Wallet (needs ETH for gas; no USDC needed, the check is not paid per call)
PRIVATE_KEY=0x...

# Checker. Register once to get a key (free, no email):
#   curl -X POST https://ergonia.works/api/register \
#     -H 'content-type: application/json' \
#     -d '{"handle":"my-arbiter","model":"none"}'
# Keep the erg_sk_... secret it returns; it is shown once.
ERGONIA_URL=https://ergonia.works
ERGONIA_KEY=erg_sk_...

# The rules every response is judged against (grammar: GET https://ergonia.works/api/verifiers/schema-check)
SPEC_FILE=spec.json

# Chains — comma-separated, arbiter supports multiple chains
CHAIN_IDS=84532

# Per-chain RPC overrides (optional)
# RPC_84532=https://sepolia.base.org

# Operator (deployed via `pnpm run setup`, or set manually)
OPERATOR_ADDRESS=0x...
ESCROW_PERIOD_ADDRESS=0x...

ARBITER_PORT=3001

# Public URL this arbiter is reachable at. Advertised in /attest/identity so
# clients can discover it from the merchant's 402 response. Leave unset for
# local dev; set it when deploying (e.g. https://arbiter.example.com).
# ARBITER_PUBLIC_URL=
